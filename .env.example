# Copy to .env (never commit .env). The repo ignores .env.
# LLM_BACKEND: anthropic (Claude), ollama (local Qwen), gateway (CS54 gateway, phase 7) or fake (tests, no model needed)
LLM_BACKEND=ollama
ANTHROPIC_API_KEY=
REVIEW_MODEL_CLAUDE=claude-haiku-5-5
OLLAMA_URL=http://localhost:11434
REVIEW_MODEL_OLLAMA=qwen2.5-coder:1.5b
# Phase 7: the CS54 gateway holds the provider keys; this app needs only its own gateway key.
GATEWAY_URL=http://localhost:4000
GATEWAY_KEY=
GATEWAY_MODEL=qwen2.5-coder:1.5b
